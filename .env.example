# Copy this file to .env and fill in your values

# ── LLM providers ──────────────────────────────────────────────────────────────
GROQ_API_KEY=gsk_your_key_here
OPENROUTER_API_KEY=sk-or-v1-your_key_here   # optional fallback

# ── JIRA Cloud integration (optional — enables "Fetch from JIRA" in the UI) ────
# JIRA_URL is your Atlassian Cloud base URL, e.g. https://yourcompany.atlassian.net
JIRA_URL=https://yourcompany.atlassian.net
JIRA_EMAIL=your.email@company.com
# Generate an API token at: https://id.atlassian.com/manage-profile/security/api-tokens
JIRA_API_TOKEN=your_jira_api_token_here
